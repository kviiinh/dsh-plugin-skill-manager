# 统一换行：仓库里存 LF，Windows 检出时也保持 LF（避免整文件 CRLF 噪声 diff）。
* text=auto eol=lf

# 明确按文本处理的类型（auto 探测偶尔会把大文件误判成二进制）。
*.md   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# Windows 批处理必须 CRLF，否则 cmd 解析会出问题。
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制/压缩产物
*.png  binary
*.jpg  binary
*.ico  binary
*.gz   binary
*.tgz  binary